# Runtime database URLs. Use server-only variables; never prefix these with NEXT_PUBLIC_.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=
# Direct PostgreSQL connection used by Prisma migrations; set this in each deployment environment.
DIRECT_URL=
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional local/demo users for prisma db:seed (never use shared passwords)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=
